{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/v1/stats",
      "destination": "/data/v1/stats.json"
    },
    {
      "source": "/api/v1/jobs",
      "destination": "/data/v1/jobs.json"
    },
    {
      "source": "/api/v1/backtest/results",
      "destination": "/data/v1/backtest_results.json"
    },
    {
      "source": "/api/v1/paper-trading/status",
      "destination": "/data/v1/paper_trading.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
